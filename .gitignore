# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 数据集：由 code/build_*.py 重新生成，常见体积几百 MB
data/*.npz
# Datasets are published on Hugging Face instead of git:
#   gomocup15.npz, teacher15.npz -> w2Tao/gomoku-15x15
# Everything else here is regenerable by code/build_*.py.

data/teacher15.npz
data/*.npy
data/*.json
data/selfplay/
data/_shard_*.npz
data/*.gz
data/gomokuparty/
data/gomocup/
data/engines/

# 模型快照：数据 + 一条训练命令即可复现
ckpt/**/model.pt
ckpt/**/best.pt
ckpt/**/*.pt
ckpt/runs/

# 基线的 manifest 保留在 git 里（它是"跑过什么"的记录），但权重不提交。
# 如果连 manifest 也不想提交，把下一行的注释去掉。
# ckpt/**/manifest.json

# 编辑器 / 操作系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.log

# Hugging Face staging: binaries are copied here at upload time
hf/_stage_model/
hf/_stage_dataset/

# Hugging Face download cache (sandbox-friendly location)
.hf_cache/

# Operator notes: personal accounts, publish workflow, local sandbox quirks.
# Not part of the published project; the other docs do not reference it.
AGENT.md
.hf_home/
*.pyc
.pytest_cache/
_duel_*.json
_duel_*.log
